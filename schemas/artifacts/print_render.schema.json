{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/print_render",
  "title": "Print Render",
  "description": "Every file the render stage produced with page_render, with the tool's own check results per file.",
  "type": "object",
  "required": [
    "version",
    "source_html",
    "outputs"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "source_html": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "format"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpg",
              "webp",
              "pdf"
            ]
          },
          "frame_id": {
            "type": "string"
          },
          "size_name": {
            "type": "string"
          },
          "pixel_size": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "pages": {
            "type": "integer"
          },
          "page_size_mm": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "page_previews": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checks_pass": {
            "type": "boolean"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "renderer": {
      "type": "string"
    }
  }
}
