{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/editorial_copy",
  "title": "Editorial Copy",
  "description": "All words of a publication, written to the lengths the flatplan allows. Produced by the magazine editorial stage.",
  "type": "object",
  "required": [
    "version",
    "pieces"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "masthead": {
      "type": "string"
    },
    "issue_line": {
      "type": "string"
    },
    "pieces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "headline",
          "body",
          "word_count",
          "language"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "cover_lines",
              "contents",
              "editor_letter",
              "feature",
              "interview",
              "column",
              "news_brief",
              "listicle",
              "review",
              "photo_essay",
              "advert",
              "back_page",
              "other"
            ]
          },
          "language": {
            "type": "string"
          },
          "kicker": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "dek": {
            "type": "string"
          },
          "byline": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "Markdown body; paragraphs separated by blank lines"
          },
          "word_count": {
            "type": "integer",
            "minimum": 0
          },
          "target_words": {
            "type": "integer",
            "minimum": 0
          },
          "pull_quotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "image_slot",
                "text"
              ],
              "properties": {
                "image_slot": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "credit": {
                  "type": "string"
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fact_check": {
            "type": "string",
            "enum": [
              "not_needed",
              "pending",
              "checked"
            ]
          }
        }
      }
    }
  }
}
