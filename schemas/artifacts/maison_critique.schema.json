                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 10
                      },
                      "send_back_to": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "not_applicable"
                    ],
                    "properties": {
                      "not_applicable": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "arabic_edition": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence"
                    ],
                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 10
                      },
                      "send_back_to": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "not_applicable"
                    ],
                    "properties": {
                      "not_applicable": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "restraint",
              "one_idea",
              "craft",
              "cohesion",
              "archive_dialogue",
              "voice",
              "typography",
              "originality"
            ],
            "additionalProperties": false
          },
          "min_score": {
            "type": "integer"
          }
        }
      }
    },
    "send_backs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "stage",
          "notes"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "notes": {
