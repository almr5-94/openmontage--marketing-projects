{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/maison_critique",
  "title": "Maison Critique",
  "description": "The luxury rubric (maison/critique/rubric.md) scored 1-5 with evidence, once by Claude and once by the local models. Below 4 on any criterion sends the work back to its stage.",
  "type": "object",
  "required": [
    "version",
    "target",
    "critics",
    "pass"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "target": {
      "type": "string"
    },
    "critics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "critic",
          "scores"
        ],
        "properties": {
          "critic": {
            "type": "string",
            "enum": [
              "claude",
              "local"
            ]
          },
          "model": {
            "type": "string"
          },
          "scores": {
            "type": "object",
            "properties": {
              "restraint": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence"
                    ],
                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 10
                      },
                      "send_back_to": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "not_applicable"
                    ],
                    "properties": {
                      "not_applicable": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "one_idea": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence"
                    ],
                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 10
                      },
                      "send_back_to": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "not_applicable"
                    ],
                    "properties": {
                      "not_applicable": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "craft": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence"
                    ],
                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 10
                      },
                      "send_back_to": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "not_applicable"
                    ],
                    "properties": {
                      "not_applicable": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "cohesion": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence"
                    ],
                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 10
                      },
                      "send_back_to": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "not_applicable"
                    ],
                    "properties": {
                      "not_applicable": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "archive_dialogue": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence"
                    ],
                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 10
                      },
                      "send_back_to": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "not_applicable"
                    ],
                    "properties": {
                      "not_applicable": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "voice": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence"
                    ],
                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 10
                      },
                      "send_back_to": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "not_applicable"
                    ],
                    "properties": {
                      "not_applicable": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "typography": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence"
                    ],
                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 10
                      },
                      "send_back_to": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "not_applicable"
                    ],
                    "properties": {
                      "not_applicable": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "originality": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
